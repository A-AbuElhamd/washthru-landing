# Copy this file to .env (or .env.local for values you don't want to commit)
# and fill in real values before deploying to production.

# The production domain this site is deployed at, with no trailing slash.
# Used for canonical URLs, hreflang alternates, JSON-LD, and the sitemap.
# Falls back to https://example.com if unset — fine for local dev, must be
# set correctly before a real deploy or every SEO tag will point at the
# wrong domain.
NEXT_PUBLIC_SITE_URL=https://example.com

# Google Search Console site-verification meta tag content. Get this from
# Search Console > Settings > Ownership verification > HTML tag method
# (paste just the `content="..."` value, not the whole tag). Optional — the
# meta tag is only rendered when this is set.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools site-verification meta tag content, same idea as
# above. Optional.
BING_SITE_VERIFICATION=

# VERCEL_ENV is set automatically by Vercel at build time (production |
# preview | development) — do NOT set this manually. It's read by
# next-sitemap.config.js to block search engines from crawling preview
# deployments. If you're not deploying to Vercel, robots.txt defaults to
# allowing all crawling; wire up your own staging-detection env var in
# next-sitemap.config.js if you need the same protection elsewhere.
